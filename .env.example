# ===================================================
# Personal Research Assistant — Environment Configuration
# ===================================================

# Tavily Search API Key (Get from https://tavily.com)
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# NVIDIA API Keys (Support for automatic key rotation & failover)
# Get from https://build.nvidia.com
NVIDIA_API_KEY_1=nvapi-your-key-1
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_API_KEY_4=
NVIDIA_API_KEY_5=

# Optional fallback single key
NVIDIA_API_KEY=

# NVIDIA Supported Chat Model (Default: nvidia/llama-3.1-nemotron-70b-instruct)
# Options:
# - nvidia/llama-3.1-nemotron-70b-instruct
# - mistralai/mistral-large-2-instruct
# - mistralai/mixtral-8x22b-v0.1
# - mistralai/mistral-7b-instruct-v0.3
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# NVIDIA API Base URL
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
